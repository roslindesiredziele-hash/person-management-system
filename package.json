{
  "name": "person-management-system",
  "version": "1.0.0",
  "description": "Full-stack person management application built with Angular, Express, TypeScript, SQLite, and Faker. Features REST APIs, data persistence, sample data generation, and reactive Angular forms.",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/roslindesiredziele/person-management-system.git"
  },
  "license": "ISC",
  "author": "Desire Roslin Dziele",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "gen": "tsc --ignoreConfig ads/gendata.ts && node ads/gendata.js",
    "gfd": "tsx ads/genfake-data.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "ngrok": "^5.0.0-beta.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsc": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true,
    "ngrok@5.0.0-beta.2": true
  }
}
